# ==============================================================================
# Secret — AWS / EKS (TEMPLATE)
# Variáveis substituídas no CI/CD pipeline via envsubst
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: api-secret
  namespace: techchallenge
  labels:
    app.kubernetes.io/name: api
    app.kubernetes.io/component: secret
    app.kubernetes.io/part-of: techchallenge
    app.kubernetes.io/environment: aws
type: Opaque
data:
  # JWT_SECRET (base64 encoded)
  JWT_SECRET: "${JWT_SECRET_BASE64}"
  # ConnectionString RDS (base64 encoded)
  ConnectionStrings__DefaultConnection: "${DB_CONNECTION_BASE64}"

---
apiVersion: v1
kind: Secret
metadata:
  name: dockerhub-secret
  namespace: techchallenge
  labels:
    app.kubernetes.io/name: api
    app.kubernetes.io/component: secret
    app.kubernetes.io/part-of: techchallenge
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "${DOCKER_CONFIG_JSON_BASE64}"
