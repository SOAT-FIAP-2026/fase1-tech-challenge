# ==============================================================================
# Secret — LOCAL (Minikube / Kind) (TEMPLATE)
# Variáveis substituídas no CI/CD pipeline via envsubst
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: api-secret
  namespace: techchallenge
  labels:
    app.kubernetes.io/name: api
    app.kubernetes.io/component: secret
    app.kubernetes.io/part-of: techchallenge
    app.kubernetes.io/environment: local
type: Opaque
data:
  # JWT_SECRET (base64 encoded)
  JWT_SECRET: "${JWT_SECRET_BASE64}"
  # ConnectionString local (base64 encoded)
  ConnectionStrings__DefaultConnection: "${DB_CONNECTION_LOCAL_BASE64}"

---
# ==============================================================================
# Secret — DockerHub (para pull da imagem)
# Se usar imagem local buildada (minikube image load), pode remover este secret
# e remover imagePullSecrets do deployment.
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: dockerhub-secret
  namespace: techchallenge
  labels:
    app.kubernetes.io/name: api
    app.kubernetes.io/component: secret
    app.kubernetes.io/part-of: techchallenge
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "${DOCKER_CONFIG_JSON_BASE64}"
