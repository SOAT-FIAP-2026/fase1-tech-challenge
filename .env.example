
# Template de variáveis de ambiente — copie para .env e preencha os valores
# ⚠️ NUNCA faça commit do arquivo .env com valores reais!

# --- PostgreSQL (RDS AWS) ---
# Obtenha DB_HOST com: terraform -chdir=../terraform-soat output rds_host
DB_HOST=SEU_RDS_ENDPOINT_AQUI
DB_PORT=5432
DB_NAME=techchallengedb
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_RDS_AQUI

# Connection string completa para a API .NET / Entity Framework
ConnectionStrings__DefaultConnection=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}

# --- API ---
API_PORT=8080

# --- JWT ---
JWT_SECRET=SEU_SECRET_JWT_AQUI
JWT_ISSUER=TechChallenge
JWT_AUDIENCE=techchallenge.com.br
