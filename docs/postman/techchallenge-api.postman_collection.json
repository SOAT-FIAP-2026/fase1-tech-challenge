              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuario Teste\",\n  \"email\": \"usuario.teste@techchallenge.com\",\n  \"login\": \"usuario.teste@techchallenge.com\",\n  \"senha\": \"Teste@123\",\n  \"idPermissao\": \"{{idPermissao}}\"\n}"
            },
            "description": "Rota protegida: exige token de um usuario Administrador e o id de uma permissao existente."
          }
        },
        {
          "name": "Login - credencial invalida (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
