{
  "info": {
    "name": "Tech Challenge - API Oficina Mecanica",
    "description": "Collection da API .NET do Tech Challenge (mesmo contrato do Swagger em /swagger).\n\nComo usar:\n1. Ajuste a variavel baseUrl (padrao http://localhost:8080).\n2. Rode 'Autenticacao > Login' — o token e salvo na variavel access_token e aplicado automaticamente as demais requisicoes.\n3. O fluxo da pasta '4. Fluxo completo da ordem de servico' cria cliente, veiculo e ordem, e percorre Diagnostico, Execucao e Finalizacao, alimentando as metricas do dashboard.\n\nTodas as requisicoes enviam X-Correlation-ID; use o mesmo valor no painel de logs do Grafana.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "login",
      "value": "admin@techchallenge.com",
      "type": "string"
    },
    {
      "key": "senha",
      "value": "Admin@123",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "veiculoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "servicoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pecaInsumoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ordemServicoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "idPermissao",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Saude e observabilidade",
      "description": "Endpoints usados pelas probes do Kubernetes, pelo Blackbox Exporter e pelo Prometheus.",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ping"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health - liveness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health - readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Endpoint sondado pelo Blackbox Exporter; alimenta os paineis de uptime."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics (Prometheus)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Exposicao OpenMetrics coletada pelo ServiceMonitor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('expoe metricas de negocio', () => pm.expect(pm.response.text()).to.include('techchallenge_'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Autenticacao",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Autenticacao/Login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "Autenticacao",
                "Login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"senha\": \"{{senha}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Salva o JWT em {{access_token}}; as demais requisicoes herdam o Bearer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const token = body.token;",
                  "pm.test('token recebido', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('access_token', token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar usuario (requer perfil Administrador)",
          "request": {
            "method": "POST",
